# Tool versions used by CI and the check container (ci/check.Dockerfile). This
# is the only place they are written down: workflows load this file, and
# tools/pins_check.py fails if one carries its own copy. The Rust version
# lives in rust-toolchain.toml. Changing BEND_COMMIT or the TLA+ pins changes
# the proof checker, so this file is lane C.
BUN_VERSION=1.4.5
NODE_VERSION=22.23.5
JAVA_VERSION=21
BEND_COMMIT=0e2f38f759cc830849e489307f3d256a7d148288
TLA_VERSION=v1.7.4
TLA_SHA256=936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88
# The check container (#55) reads every key above and these. The checksums
# are upstream's, for the linux x86_64 builds: bun's and node's
# SHASUMS256.txt, Adoptium's .sha256.txt and rustup-init.sha256.
# CHECK_BASE_IMAGE is the index digest of ubuntu:24.04. UBUNTU_SNAPSHOT fixes
# the apt archive that python3, git and gcc come from, and PYTHON_VERSION is
# the python3 in it. JRE_VERSION is the exact Temurin build of JAVA_VERSION;
# CI's setup-java still takes only the major.
CHECK_BASE_IMAGE=docker.io/library/ubuntu@sha256:9c7f200c07e3d4a03e7249d2c16bf66a51120fb876aa2242cf31451412543289
UBUNTU_SNAPSHOT=20261115T000000Z
PYTHON_VERSION=3.12.3
BUN_SHA256=94559b3b528995a49452f9f2404cec74f2efd7d06e0a000a8cd214b02c3666eb
NODE_SHA256=cdeb8670a0c81f51b4dc4ac61919f9b1ad917b304bf8221eb939570663d240f8
JRE_VERSION=21.0.13.1+2
JRE_SHA256=18f44fab9065217f3ba61d0eef8a7b5f3c3713aa7293001b0d4ac10ede3850f0
RUSTUP_VERSION=1.29.3
RUSTUP_INIT_SHA256=b1c8cb14e30889e7e2999e6b69e62d9e9b9ffc0f4df8180564d306d9680e6c55
