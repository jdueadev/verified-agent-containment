  match x:
    case True{}:
      match a:
        case True{}:
          match b:
            case True{}:
              match c:
                case True{}:
                  {==}
                case False{}:
                  {==}
            case False{}:
              match c:
                case True{}:
                  {==}
                case False{}:
                  {==}
        case False{}:
          match b:
            case True{}:
              match c:
                case True{}:
                  {==}
                case False{}:
                  {==}
            case False{}:
              match c:
                case True{}:
                  {==}
                case False{}:
                  {==}
    case False{}:
