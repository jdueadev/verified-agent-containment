def true_motive(b: Bool) -> Type:
  match b:
    case True{}:
      Unit
    case False{}:
      Empty

def false_motive(b: Bool) -> Type:
  match b:
    case True{}:
      Empty
    case False{}:
      Unit

def true_is_not_false(h: {True{} == False{} : Bool}) -> Empty:
  %h : true_motive(_)
  Unit{}

def false_is_not_true(h: {False{} == True{} : Bool}) -> Empty:
  %h : false_motive(_)
  Unit{}

def min_le(t: Nat, +m: Nat) -> {Nat.is_le(Nat.min(t, m), m) == True{} : Bool}:
  match t m:
    case 0n 0n:
      {==}
    case 0n 1n+p:
      {==}
    case 1n+a 0n:
      {==}
    case 1n+a 1n+p:
      min_le(a, p)

def add_mono(now: Nat, -a: Nat, -b: Nat, h: {Nat.is_le(a, b) == True{} : Bool}) -> {Nat.is_le(Nat.add(now, a), Nat.add(now, b)) == True{} : Bool}:
  match now:
    case 0n:
      h
    case 1n+p:
      add_mono(p, a, b, h)

def eq_refl(n: Nat) -> {Nat.is_eq(n, n) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      eq_refl(p)

def le_refl(n: Nat) -> {Nat.is_le(n, n) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      le_refl(p)

def lt_irrefl(n: Nat) -> {Nat.is_lt(n, n) == False{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      lt_irrefl(p)

def not_lt_le(a: Nat, +b: Nat, h: {Nat.is_lt(a, b) == False{} : Bool}) -> {Nat.is_le(b, a) == True{} : Bool}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      Empty.absurd({Nat.is_le(1n+q, 0n) == True{} : Bool}, true_is_not_false(h))
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      not_lt_le(p, q, h)

def eff_le_with(stale: Bool, +now: Nat, +clock: Nat, h: {Nat.is_lt(now, clock) == stale : Bool}) -> {Nat.is_le(clock, K.effective_with(stale, now, clock)) == True{} : Bool}:
  match stale:
    case True{}:
      le_refl(clock)
    case False{}:
      not_lt_le(now, clock, h)

def eff_le(+now: Nat, +clock: Nat) -> {Nat.is_le(clock, K.effective_time(now, clock)) == True{} : Bool}:
  eff_le_with(Nat.is_lt(now, clock), now, clock, {==})

def eff_stale(stale: Bool, +now: Nat, +clock: Nat, h: {stale == True{} : Bool}) -> {K.effective_with(stale, now, clock) == clock : Nat}:
  match stale:
    case True{}:
      {==}
    case False{}:
      Empty.absurd({K.effective_with(False{}, now, clock) == clock : Nat}, false_is_not_true(h))

