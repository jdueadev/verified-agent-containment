            case K.ToRestrict{}:
              Empty.absurd({Laws.is_kill(Laws.mode_of(K.seal(at, cnt, K.raise_after(cfg, at, K.cap_classifier(K.ToRestrict{}), K.settle_with(cfg, True{}, at, K.ModeKill{}, d))))) == False{} : Bool}, true_is_not_false(k))
